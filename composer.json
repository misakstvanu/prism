{
    "name": "misakstvanu/prism",
    "description": "Prism client — captures Laravel telemetry (logs, requests, errors, traces, queries, jobs, crons, replica metrics) and ships it to a Prism observability workspace.",
    "type": "library",
    "keywords": [
        "laravel",
        "observability",
        "monitoring",
        "telemetry"
    ],
    "license": "MIT",
    "version": "1.0.2",
    "require": {
        "php": "^8.4",
        "illuminate/support": "^12.0|^13.0",
        "keepsuit/laravel-opentelemetry": "^2.2",
        "laravel/nightwatch": "^1.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.7|^4.0|^5.0"
    },
    "autoload": {
        "psr-4": {
            "Misakstvanu\\Prism\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Misakstvanu\\Prism\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Misakstvanu\\Prism\\PrismServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
